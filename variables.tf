variable "display_name" {
  type        = string
  description = "(Required) The display name of the app registration."

  validation {
    condition     = length(trimspace(var.display_name)) > 0
    error_message = "The display_name value must not be empty."
  }
}

variable "app_role_assignment_required" {
  type        = bool
  description = "(Optional) Whether users and groups must be assigned to the enterprise application before they can sign in. Only used when create_service_principal is true."
  default     = false
}

variable "create_service_principal" {
  type        = bool
  description = "(Optional) Whether to create the enterprise application (service principal) associated with the app registration."
  default     = true
}

variable "description" {
  type        = string
  description = "(Optional) A description of the app registration. It is also applied to the enterprise application when create_service_principal is true."
  default     = null
}

variable "federated_credentials" {
  type = map(object({
    issuer      = string
    subject     = string
    audiences   = optional(list(string), ["api://AzureADTokenExchange"])
    description = optional(string)
  }))
  description = "(Optional) Map of federated identity credentials to configure on the app registration, which allows external workloads to authenticate without a secret. The map key is used as the credential display name."
  default     = {}

  validation {
    condition     = alltrue([for credential in values(var.federated_credentials) : startswith(credential.issuer, "https://")])
    error_message = "Each federated credential issuer must be an URL starting with https://."
  }

  validation {
    condition     = alltrue([for credential in values(var.federated_credentials) : length(trimspace(credential.subject)) > 0])
    error_message = "Each federated credential subject must not be empty."
  }

  validation {
    condition     = alltrue([for credential in values(var.federated_credentials) : length(credential.audiences) > 0])
    error_message = "Each federated credential must have at least one audience."
  }
}

variable "flexible_federated_credentials" {
  type = map(object({
    issuer                     = string
    claims_matching_expression = string
    audience                   = optional(string, "api://AzureADTokenExchange")
    description                = optional(string)
  }))
  description = "(Optional) Map of flexible federated identity credentials (preview) to configure on the app registration. They use a claims matching expression (e.g. \"claims['sub'] matches 'organization:org:project:proj:workspace:*:run_phase:*'\") instead of an exact subject, so a single credential can cover multiple workspaces and run phases. Only supported by GitHub, GitLab and HCP Terraform issuers. The map key is used as the credential display name."
  default     = {}

  validation {
    condition     = alltrue([for credential in values(var.flexible_federated_credentials) : startswith(credential.issuer, "https://")])
    error_message = "Each flexible federated credential issuer must be an URL starting with https://."
  }

  validation {
    condition     = alltrue([for credential in values(var.flexible_federated_credentials) : can(regex("^claims\\['[A-Za-z0-9_]+'\\] (eq|matches) '[^']+'", credential.claims_matching_expression))])
    error_message = "Each flexible federated credential claims_matching_expression must start with claims['<claim>'] followed by the eq or matches operator and a single-quoted value."
  }

  validation {
    condition     = alltrue([for credential in values(var.flexible_federated_credentials) : length(trimspace(credential.audience)) > 0])
    error_message = "Each flexible federated credential audience must not be empty."
  }
}

variable "owners" {
  type        = list(string)
  description = "(Optional) List of object IDs (users or service principals) that will be owners of the app registration and of the enterprise application."
  default     = []

  validation {
    condition     = alltrue([for owner in var.owners : can(regex("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", owner))])
    error_message = "Each owner must be a valid object ID (GUID)."
  }
}

variable "secret" {
  type = object({
    end_date     = string
    display_name = optional(string, "terraform-managed")
  })
  description = "(Optional) Client secret to generate for the app registration. The secret value is generated by Entra ID, stored in the Terraform state and exposed through the sensitive client_secret output. The end_date is required and must be an RFC 3339 timestamp (e.g. 2027-12-31T23:59:59Z). When null, no secret is created."
  default     = null

  validation {
    condition     = var.secret == null ? true : can(timecmp(var.secret.end_date, "2000-01-01T00:00:00Z"))
    error_message = "The secret end_date must be a valid RFC 3339 timestamp (e.g. 2027-12-31T23:59:59Z)."
  }

  validation {
    condition     = var.secret == null ? true : length(trimspace(var.secret.display_name)) > 0
    error_message = "The secret display_name must not be empty."
  }
}

variable "sign_in_audience" {
  type        = string
  description = "(Optional) The Microsoft identity platform audiences supported by the app registration. Possible values are AzureADMyOrg, AzureADMultipleOrgs, AzureADandPersonalMicrosoftAccount or PersonalMicrosoftAccount."
  default     = "AzureADMyOrg"

  validation {
    condition     = contains(["AzureADMyOrg", "AzureADMultipleOrgs", "AzureADandPersonalMicrosoftAccount", "PersonalMicrosoftAccount"], var.sign_in_audience)
    error_message = "The sign_in_audience value must be one of: AzureADMyOrg, AzureADMultipleOrgs, AzureADandPersonalMicrosoftAccount, PersonalMicrosoftAccount."
  }
}
