# The following resource block is used to create the app registration.

resource "azuread_application" "main" {
  display_name     = var.display_name
  description      = var.description
  owners           = var.owners
  sign_in_audience = var.sign_in_audience
}

# The following resource block is used to create the enterprise application (service principal) associated with the app registration.

resource "azuread_service_principal" "main" {
  count = var.create_service_principal ? 1 : 0

  client_id                    = azuread_application.main.client_id
  app_role_assignment_required = var.app_role_assignment_required
  description                  = var.description
  owners                       = var.owners
}

# The following resource block is used to generate a client secret with an explicit expiration date.
# The secret value is generated by Entra ID.

resource "azuread_application_password" "main" {
  count = var.secret != null ? 1 : 0

  application_id = azuread_application.main.id
  display_name   = var.secret.display_name
  end_date       = var.secret.end_date
}

# The following resource block is used to configure federated identity credentials, allowing external workloads to authenticate without a secret.

resource "azuread_application_federated_identity_credential" "main" {
  for_each = var.federated_credentials

  application_id = azuread_application.main.id
  display_name   = each.key
  description    = each.value.description
  audiences      = each.value.audiences
  issuer         = each.value.issuer
  subject        = each.value.subject
}
